{
  "name": "codex-quota-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=dist/main/main.js && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main/preload.cjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
